{
  "name": "@robmclarty/atis",
  "version": "0.0.0",
  "description": "A weather map for code changes: what changed, how far it reaches, what evidence covers it, and what to look at first.",
  "keywords": [
    "code-review",
    "visualization",
    "git",
    "typescript",
    "checkride",
    "fallow"
  ],
  "homepage": "https://github.com/robmclarty/atis#readme",
  "bugs": "https://github.com/robmclarty/atis/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robmclarty/atis.git",
    "directory": "apps/atis"
  },
  "license": "Apache-2.0",
  "author": "Rob McLarty",
  "type": "module",
  "bin": {
    "atis": "./dist/cli.js"
  },
  "scripts": {
    "prepack": "pnpm --workspace-root run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__/**",
    "web"
  ],
  "dependencies": {
    "playwright-core": "1.64.1",
    "typescript": "6.0.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "core": "workspace:*",
    "svg": "workspace:*",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
